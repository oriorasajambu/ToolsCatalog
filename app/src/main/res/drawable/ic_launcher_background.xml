<?xml version="1.0" encoding="utf-8"?>
<!--
  Toolbox launcher — background layer.
  The emerald ground: a diagonal gradient from #12B48F to #0B8F86 across the full 108x108 canvas,
  lifted verbatim from the "Toolbox · App icon" design direction. Full-bleed so every launcher mask
  crops into solid colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF12B48F" />
                <item android:offset="1" android:color="#FF0B8F86" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
