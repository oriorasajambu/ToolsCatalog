<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP, allowed for the emulator's host alias only.

  minSdk 29 blocks cleartext by default, which is correct — but it also blocks the debug base URL
  (http://10.0.2.2:8080), so the scaffold would fail its first request with no obvious cause.

  Scoped to a literal address on purpose. Android's <domain> element does exact hostname or
  IP-literal matching and subdomain-suffix matching; it has no CIDR support, so an entry like
  "192.168.0.0/16" silently matches nothing. If a real device on a LAN needs cleartext, add its
  literal address here — do not widen this to a global base-config.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
