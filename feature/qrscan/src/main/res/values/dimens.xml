<?xml version="1.0" encoding="utf-8"?>
<!--
  Spacing tokens for this feature. Values live here rather than as `16.dp` literals in the
  composables so a density change is one edit, and so the report's indentation stays consistent
  between the segment cards and the subtag rows.
-->
<resources>
    <dimen name="qrscan_spacing">16dp</dimen>
    <dimen name="qrscan_spacing_tight">4dp</dimen>
    <dimen name="qrscan_subtag_indent">12dp</dimen>
    <dimen name="qrscan_input_min_height">96dp</dimen>
    <dimen name="qrscan_qr_size">200dp</dimen>

    <!-- Viewfinder overlay -->
    <dimen name="qrscan_reticle_stroke">3dp</dimen>
    <dimen name="qrscan_reticle_corner">24dp</dimen>
    <dimen name="qrscan_focus_ring_radius">32dp</dimen>
</resources>
