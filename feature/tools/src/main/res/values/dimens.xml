<?xml version="1.0" encoding="utf-8"?>
<!-- Spacing and shape tokens for the Midnight Pro home. -->
<resources>
    <dimen name="tools_gutter">20dp</dimen>
    <dimen name="tools_section_gap">22dp</dimen>
    <dimen name="tools_row_gap">12dp</dimen>
    <dimen name="tools_card_padding">20dp</dimen>
    <dimen name="tools_row_padding">14dp</dimen>
    <dimen name="tools_hero_text_gap">6dp</dimen>

    <!-- The hairline every card and the hero draw their outline with. One token, not three call
         sites: three copies of the same border width is how two of them end up at 1dp and one at
         2dp after somebody nudges a single card. -->
    <dimen name="tools_border">1dp</dimen>
    <dimen name="tools_scanline_thickness">2dp</dimen>

    <dimen name="tools_hero_radius">24dp</dimen>
    <dimen name="tools_card_radius">16dp</dimen>
    <dimen name="tools_tile_radius">12dp</dimen>

    <dimen name="tools_brand_tile">36dp</dimen>
    <dimen name="tools_row_tile">44dp</dimen>
    <dimen name="tools_util_tile">38dp</dimen>

    <dimen name="tools_hero_qr">92dp</dimen>
    <dimen name="tools_hero_qr_radius">16dp</dimen>
    <dimen name="tools_hero_qr_inset">8dp</dimen>

    <!-- Widget configuration screen. -->
    <dimen name="tools_widget_row_gap">4dp</dimen>
    <dimen name="tools_widget_row_padding">12dp</dimen>
    <dimen name="tools_widget_row_tile">36dp</dimen>
    <dimen name="tools_widget_block_gap">16dp</dimen>

    <!-- The drag handle's own hit area. Bigger than the glyph so the grab does not depend on
         hitting a 24dp icon exactly, which is the difference between a drag that works and one
         that scrolls the list instead. -->
    <dimen name="tools_widget_drag_handle">48dp</dimen>

    <!-- How far a dragged row is lifted, so it reads as above the list rather than in it. -->
    <dimen name="tools_widget_drag_elevation">6dp</dimen>
</resources>
