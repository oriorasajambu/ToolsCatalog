<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the one subdirectory the exporter writes to. A bare <cache-path path="."> would hand any app
  the share sheet reaches a readable handle on the whole cache — which for this feature would mean
  handing out photos the user picked precisely because they wanted them handled carefully.
-->
<paths>
    <cache-path
        name="clean"
        path="clean/" />
</paths>
