    <!-- Permission -->
    <string name="speedometer_permission_rationale">This needs location access to read your device\'s satellite receiver. Nothing is sent anywhere — there is no map, no network, and no data connection involved.</string>
    <string name="speedometer_permission_grant">Allow location access</string>
    <string name="speedometer_permission_blocked">Location access is turned off for this app. You can switch it back on in Settings.</string>
    <string name="speedometer_permission_open_settings">Open settings</string>

    <!--
      The subtle case. Approximate location is deliberately coarsened to roughly a city block and is
      re-coarsened on every request, so consecutive readings jump around a grid. A speed derived from
      that is not merely imprecise, it is meaningless. The user chose this in the system dialog, so it
      earns an explanation rather than an error.
    -->
    <string name="speedometer_permission_approximate">You granted approximate location, which is deliberately rounded to about a city block. Speed and altitude cannot be worked out from it. Precise location is needed — it stays on the device.</string>
    <string name="speedometer_permission_upgrade">Allow precise location</string>

