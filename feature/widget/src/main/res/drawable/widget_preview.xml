<?xml version="1.0" encoding="utf-8"?>
<!--
  The API 29-30 picker preview.

  SPEC.md section 5.5 called for a PNG in drawable-nodpi. A vector is used instead, for two
  reasons: it is reviewable as text, where a binary asset is opaque in a diff and can only be
  regenerated by whoever has the original; and it scales to whatever cell the launcher measures
  rather than being resampled from one fixed raster.

  Five tiles rather than five real glyphs. The picker is asking "what shape is this widget", and
  an abstract strip answers that without pretending to show tools the user has not chosen yet -
  which also means it cannot drift when the catalog changes.

  Fixed colours, deliberately, and the reason is the one CLAUDE.md already records for camera
  overlays: this is drawn over the launcher's wallpaper, not over the app, so it answers to what is
  behind it rather than to the palette.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="250dp"
    android:height="50dp"
    android:viewportWidth="250"
    android:viewportHeight="50">

    <!-- The widget background. -->
    <path
        android:fillColor="#1C1F2B"
        android:pathData="M8,0 L242,0 A8,8 0 0 1 250,8 L250,42 A8,8 0 0 1 242,50 L8,50 A8,8 0 0 1 0,42 L0,8 A8,8 0 0 1 8,0 Z" />

    <!-- Five evenly spaced tiles, matching the strip's equal-share layout. -->
    <path
        android:fillColor="#8B7DF6"
        android:pathData="M17,17 L33,17 A3,3 0 0 1 36,20 L36,30 A3,3 0 0 1 33,33 L17,33 A3,3 0 0 1 14,30 L14,20 A3,3 0 0 1 17,17 Z" />
    <path
        android:fillColor="#8B7DF6"
        android:pathData="M65,17 L81,17 A3,3 0 0 1 84,20 L84,30 A3,3 0 0 1 81,33 L65,33 A3,3 0 0 1 62,30 L62,20 A3,3 0 0 1 65,17 Z" />
    <path
        android:fillColor="#8B7DF6"
        android:pathData="M113,17 L129,17 A3,3 0 0 1 132,20 L132,30 A3,3 0 0 1 129,33 L113,33 A3,3 0 0 1 110,30 L110,20 A3,3 0 0 1 113,17 Z" />
    <path
        android:fillColor="#8B7DF6"
        android:pathData="M161,17 L177,17 A3,3 0 0 1 180,20 L180,30 A3,3 0 0 1 177,33 L161,33 A3,3 0 0 1 158,30 L158,20 A3,3 0 0 1 161,17 Z" />
    <path
        android:fillColor="#8B7DF6"
        android:pathData="M209,17 L225,17 A3,3 0 0 1 228,20 L228,30 A3,3 0 0 1 225,33 L209,33 A3,3 0 0 1 206,30 L206,20 A3,3 0 0 1 209,17 Z" />
</vector>
