<?xml version="1.0" encoding="utf-8"?>
<!--
  Spacing and drawing tokens for this feature. Values live here rather than as `16.dp` literals in
  the composables so a density change is one edit, matching :feature:level and :feature:qrscan.
-->
<resources>
    <dimen name="soundmeter_spacing">16dp</dimen>
    <dimen name="soundmeter_spacing_tight">8dp</dimen>

    <!-- Gauge -->
    <dimen name="soundmeter_arc_stroke">18dp</dimen>
    <!-- The 85 dB mark, which has to read as a boundary rather than as part of the arc. -->
    <dimen name="soundmeter_tick_length">6dp</dimen>

    <!-- History strip -->
    <dimen name="soundmeter_chart_height">96dp</dimen>
    <dimen name="soundmeter_chart_stroke">2dp</dimen>
    <dimen name="soundmeter_chart_grid">1dp</dimen>
</resources>
